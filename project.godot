; Engine configuration file. Do not edit by hand unless you know the format.
config_version=5

[application]
config/name="Stonebalance"
config/description="A relaxing realistic 3D stone-stacking puzzle game."
run/main_scene="res://game/scenes/main.tscn"
config/features=PackedStringArray("4.4", "Mobile")

[autoload]
Settings="*res://game/scripts/settings_manager.gd"
Save="*res://game/scripts/save_system.gd"
Progression="*res://game/scripts/progression.gd"
Audio="*res://game/scripts/audio_manager.gd"

[display]
window/size/viewport_width=1080
window/size/viewport_height=1920
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1


[physics]
3d/physics_engine="JoltPhysics3D"
common/physics_ticks_per_second=60

[rendering]
renderer/rendering_method="mobile"
